<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">

      <!-- Update rate in Hz -->
      <update_rate>50</update_rate>

      <!-- Wheels joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematics properties (YP100) -->
      <wheel_separation>0.220</wheel_separation>
      <wheel_diameter>0.065</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>30</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- Input command topic -->
      <command_topic>cmd_vel</command_topic>

      <!-- Output odometry -->
      <publish_odom>true</publish_odom>
      <!-- publish_odom_tf MUST be false: robot_localization EKF handles TF odom -> base_footprint -->
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_topic>wheel/odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <!-- Odometry covariance settings -->
      <covariance_x>0.001</covariance_x>
      <covariance_y>0.001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>

    </plugin>
  </gazebo>

</robot>
