<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_obstacle_world">

    <!-- Physics Engine Settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Outer Perimeter Walls (10m x 8m) -->
    <model name="outer_walls">
      <static>true</static>
      
      <!-- North Wall -->
      <link name="north_wall">
        <pose>0 4.0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- South Wall -->
      <link name="south_wall">
        <pose>0 -4.0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- East Wall -->
      <link name="east_wall">
        <pose>5.0 0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- West Wall -->
      <link name="west_wall">
        <pose>-5.0 0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- Interior Divider Wall 1 -->
      <link name="interior_wall_1">
        <pose>-1.0 1.5 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 4.8 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.8 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>

      <!-- Interior Divider Wall 2 -->
      <link name="interior_wall_2">
        <pose>1.5 -1.5 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.5 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.2 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles Inside Rooms and Corridors -->
    <!-- Pillar 1 -->
    <model name="pillar_1">
      <static>true</static>
      <pose>2.5 1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pillar 2 -->
    <model name="pillar_2">
      <static>true</static>
      <pose>-3.0 -1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 1 -->
    <model name="box_1">
      <static>true</static>
      <pose>-3.2 2.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 2 -->
    <model name="box_2">
      <static>true</static>
      <pose>3.5 -2.5 0.4 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.8 0.8</size></box></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
